<Window x:Class="WalkaAmazonIntelligence.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WALKA Amazon Intelligence" Width="1320" Height="860" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" FlowDirection="{Binding Direction}" Language="{Binding UiLanguage}">
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="WALKA" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,0"/><TextBlock Text="{DynamicResource Title}" FontSize="30" FontWeight="Light"/></StackPanel><TextBlock Text="{DynamicResource Subtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,10" VerticalAlignment="Center"><TextBlock Text="{Binding EnvironmentLabel}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/></Border>
  </Grid>
  <TabControl Grid.Row="1">
   <TabItem Header="{DynamicResource Dashboard}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <WrapPanel Margin="0,0,0,18"><DatePicker SelectedDate="{Binding StartDate}" Width="145" Margin="0,8,12,8"/><TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker SelectedDate="{Binding EndDate}" Width="145" Margin="0,8,20,8"/><Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}"/></WrapPanel>
    <UniformGrid Columns="4"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Sales}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding SalesValue}" FontSize="27" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Spend}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding SpendValue}" FontSize="27" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Acos}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding AcosValue}" FontSize="27" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Coverage}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding CoverageValue}" FontSize="20" Margin="0,12,0,0"/></StackPanel></Border></UniformGrid>
    <TextBlock Text="{DynamicResource ScopeNote}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,20"/>
    <DataGrid ItemsSource="{Binding Products}" Height="310"><DataGrid.Columns>
     <DataGridTextColumn Header="{DynamicResource AsinColumn}" Binding="{Binding Asin}" Width="*"/><DataGridTextColumn Header="{DynamicResource SalesColumn}" Binding="{Binding Sales,StringFormat=N2,TargetNullValue=—}" Width="110"/>
     <DataGridTextColumn Header="{DynamicResource UnitsColumn}" Binding="{Binding Units,TargetNullValue=—}" Width="75"/><DataGridTextColumn Header="{DynamicResource OrderItemsColumn}" Binding="{Binding OrderItems,TargetNullValue=—}" Width="105"/>
     <DataGridTextColumn Header="{DynamicResource SessionsColumn}" Binding="{Binding Sessions,TargetNullValue=—}" Width="90"/><DataGridTextColumn Header="{DynamicResource AdSpendColumn}" Binding="{Binding AdSpend,StringFormat=N2,TargetNullValue=—}" Width="100"/>
     <DataGridTextColumn Header="{DynamicResource AdSalesColumn}" Binding="{Binding AdSales,StringFormat=N2,TargetNullValue=—}" Width="115"/><DataGridTextColumn Header="{DynamicResource AcosColumn}" Binding="{Binding Acos,StringFormat=P1,TargetNullValue=—}" Width="85"/>
     <DataGridTextColumn Header="{DynamicResource RoasColumn}" Binding="{Binding Roas,StringFormat=N2,TargetNullValue=—}" Width="85"/><DataGridTextColumn Header="{DynamicResource TacosColumn}" Binding="{Binding Tacos,StringFormat=P1,TargetNullValue=—}" Width="90"/>
    </DataGrid.Columns></DataGrid>
    <TextBlock Text="{DynamicResource NoData}" Margin="0,18,0,0" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Products.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource Connections}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{DynamicResource ConnectionNote}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>
    <UniformGrid Columns="4"><StackPanel><TextBlock Text="{DynamicResource Account}"/><TextBox Text="{Binding Account,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Marketplace}"/><TextBox Text="{Binding Marketplace,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Profile}"/><TextBox Text="{Binding Profile,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Currency}"/><TextBox Text="{Binding Currency}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Region}"/><TextBox Text="{Binding Region}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource SellerClientId}"/><TextBox Text="{Binding SellerClientId}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource AdsClientId}"/><TextBox Text="{Binding AdsClientId}"/></StackPanel></UniformGrid>
    <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
    <UniformGrid Columns="2" Margin="0,16,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Amazon SP-API" FontSize="22"/><TextBlock Text="{Binding SellerStatus}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,16"/><TextBlock Text="{DynamicResource SellerSecret}"/><PasswordBox x:Name="SellerSecret"/><TextBlock Text="{DynamicResource SellerRefresh}"/><PasswordBox x:Name="SellerRefresh"/><Button Content="{DynamicResource TestSellerConnection}" Command="{Binding TestSellerConnectionCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Amazon Advertising" FontSize="22"/><TextBlock Text="{Binding AdsStatus}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,16"/><TextBlock Text="{DynamicResource AdsSecret}"/><PasswordBox x:Name="AdsSecret"/><TextBlock Text="{DynamicResource AdsRefresh}"/><PasswordBox x:Name="AdsRefresh"/><Button Content="{DynamicResource TestAdsConnection}" Command="{Binding TestAdsConnectionCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border></UniformGrid>
    <Button Content="{DynamicResource ProtectSecrets}" Click="ProtectSecrets_Click" HorizontalAlignment="Left"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource Evidence}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <WrapPanel><DatePicker SelectedDate="{Binding ReportDate}" Width="145" Margin="0,8,18,8"/><Button Content="{DynamicResource SellerSync}" Command="{Binding SellerSyncCommand}"/><Button Content="{DynamicResource AdsSync}" Command="{Binding AdsSyncCommand}"/><Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}"/></WrapPanel>
    <DataGrid ItemsSource="{Binding Runs}" Height="210" Margin="0,14,0,20"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource SourceColumn}" Binding="{Binding Source}" Width="100"/><DataGridTextColumn Header="{DynamicResource DateColumn}" Binding="{Binding Date}" Width="120"/><DataGridTextColumn Header="{DynamicResource StatusColumn}" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="{DynamicResource RecordsColumn}" Binding="{Binding Records}" Width="90"/><DataGridTextColumn Header="{DynamicResource ReportIdColumn}" Binding="{Binding RemoteReportId}" Width="*"/><DataGridTextColumn Header="{DynamicResource ErrorColumn}" Binding="{Binding Error}" Width="220"/></DataGrid.Columns></DataGrid>
    <DataGrid ItemsSource="{Binding Artifacts}" Height="220"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource SourceColumn}" Binding="{Binding Source}" Width="100"/><DataGridTextColumn Header="{DynamicResource DateColumn}" Binding="{Binding Start}" Width="120"/><DataGridTextColumn Header="{DynamicResource StatusColumn}" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="{DynamicResource RowsColumn}" Binding="{Binding RecordCount}" Width="80"/><DataGridTextColumn Header="{DynamicResource ShaColumn}" Binding="{Binding Sha256}" Width="*"/><DataGridTextColumn Header="{DynamicResource BytesColumn}" Binding="{Binding Size}" Width="100"/></DataGrid.Columns></DataGrid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource Settings}"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding StoragePath}" FontSize="20"/><TextBlock Text="{DynamicResource StorageHint}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/></StackPanel></Border><WrapPanel><Button Content="{DynamicResource Theme}" Command="{Binding ThemeCommand}"/><Button Content="{DynamicResource Language}" Command="{Binding LanguageCommand}"/><Button Content="{DynamicResource Backup}" Command="{Binding BackupCommand}"/></WrapPanel></StackPanel></TabItem>
   <TabItem Header="{DynamicResource About}"><Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="WALKA Amazon Intelligence" FontSize="28"/><TextBlock Text="{Binding Version}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,20"/><TextBlock Text="{DynamicResource AboutBody}" FontSize="16" MaxWidth="780" HorizontalAlignment="Left" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource AboutReadOnly}" Margin="0,20,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border></TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="{DynamicResource FieldBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,22,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="v0.1.0" Foreground="{DynamicResource MutedBrush}" Margin="20,0,0,0"/><ProgressBar DockPanel.Dock="Right" Width="70" Height="4" IsIndeterminate="{Binding Busy}" Margin="12,0"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></DockPanel></Border>
 </Grid>
</Window>